# ---------------------------------------------------------------------------
# Residencial Aurora - variaveis de ambiente
#
# Copie este arquivo para `.env` e preencha os valores:
#     cp .env.example .env
#
# O `.env` esta no .gitignore e NUNCA deve ser versionado.
# Este arquivo (.env.example) e versionado e contem apenas os NOMES das
# variaveis, sem valores.
# ---------------------------------------------------------------------------

# Chave de API do Google AI Studio, usada para falar com os modelos Gemini:
# pelos agentes (Google ADK) e pela geracao dos vetores do regulamento, que
# roda dentro de `uv run aurora-restaurar`. Gere a sua em
# https://aistudio.google.com/apikey
#
# ATENCAO: esta chave e lida por `app/config.py` (Configuracao.google_api_key)
# e PASSADA explicitamente a quem precisa dela. O comentario anterior aqui
# dizia que o google-genai a lia "direto" deste arquivo, e isso era FALSO: o
# SDK le o os.environ, e um arquivo .env nao chega la sozinho. Com a chave
# preenchida, `aurora-restaurar` recusava dizendo que nao havia chave. Ver
# ADR-0020.
GOOGLE_API_KEY=

# Seleciona o backend dos modelos Gemini.
# FALSE (ou 0) -> Gemini API do Google AI Studio, autenticando com a
#                 GOOGLE_API_KEY acima. E o que este projeto usa.
# TRUE  (ou 1) -> Vertex AI / Google Cloud, que exigiria GOOGLE_CLOUD_PROJECT
#                 e GOOGLE_CLOUD_LOCATION em vez da chave. Nao usado aqui.
# Nas versoes atuais do google-genai esta variavel se chama
# GOOGLE_GENAI_USE_ENTERPRISE; o nome antigo GOOGLE_GENAI_USE_VERTEXAI ainda
# funciona como alias (se ambos forem definidos, USE_ENTERPRISE vence).
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
